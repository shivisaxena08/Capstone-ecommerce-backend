# Copy this file to ".env" and change the secrets. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_capstone

# Use long random strings (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Default low-stock threshold for products that don't define their own
LOW_STOCK_THRESHOLD=5
CLIENT_ORIGIN=*
